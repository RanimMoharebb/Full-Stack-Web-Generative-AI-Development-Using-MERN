{
  "compilerOptions": {
    "target": "es6",      // modern JS for browsers
    "module": "none",     // simple JS for browser
    "rootDir": "./",      // .ts files are in this folder
    "outDir": "./",       // output .js in same folder
    "strict": true,       // optional, good for learning
    "sourceMap": true     // optional, for debugging
  },
  "include": ["*.ts"]     // include all .ts files in this folder
}